{
  // Optional: how the live demo is hosted (`pnpm deploy:demo`). The site is
  // plain static files in dist/, so any static host works; this file is not
  // needed otherwise.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-sage-demo",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "astro-sage.chintak.sh", "custom_domain": true }],
  // Per-PR previews (.github/workflows/preview.yml) are Worker versions served
  // at *-astro-sage-demo.<account>.workers.dev; the plain workers.dev URL
  // stays off.
  "workers_dev": false,
  "preview_urls": true
}
