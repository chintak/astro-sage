{
  "name": "astro-sage-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @astro-sage/demo dev",
    "build": "pnpm --filter @astro-sage/demo build",
    "preview": "pnpm --filter @astro-sage/demo preview",
    "check": "pnpm --filter @astro-sage/demo exec astro check",
    "lint": "oxlint",
    "format": "prettier --write \"packages/**/*.{ts,astro,css}\" \"apps/demo/**/*.ts\"",
    "format:check": "prettier --check \"packages/**/*.{ts,astro,css}\" \"apps/demo/**/*.ts\"",
    "test": "pnpm --filter astro-sage test && pnpm --filter @astro-sage/demo test",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "changeset tag && git push --follow-tags",
    "deploy:demo": "pnpm build && pnpm --filter @astro-sage/demo exec wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "oxlint": "^1.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
