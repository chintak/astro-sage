{
  "name": "astro-sage-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "pnpm --filter @astro-sage/demo dev",
    "build": "pnpm --filter @astro-sage/demo build",
    "preview": "pnpm --filter @astro-sage/demo preview",
    "check": "pnpm --filter @astro-sage/demo exec astro check",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
