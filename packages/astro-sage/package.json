{
  "name": "astro-sage",
  "version": "0.1.0",
  "description": "A readability-first Astro blog theme: serif typography, warm sepia palette, pinned TOC, KaTeX, Expressive Code.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "blog",
    "theme"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./content": "./src/content.ts",
    "./markdown": "./src/markdown/index.ts",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "src",
    "migrations"
  ],
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.2",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@expressive-code/plugin-collapsible-sections": "^0.44.2",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/literata": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@pagefind/default-ui": "^1.5.2",
    "@tailwindcss/vite": "^4.3.2",
    "astro-expressive-code": "^0.44.2",
    "better-auth": "^1.7.10",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.0",
    "satori": "^0.26.0",
    "satteri": "^0.9.3",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/katex": "^0.16.7",
    "astro": "^7.0.3"
  }
}
