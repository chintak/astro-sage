---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@sage/layouts/Layout.astro";
import Header from "@sage/components/Header.astro";
import Main from "@sage/components/Main.astro";
import Footer from "@sage/components/Footer.astro";
import { getAllSeries } from "@sage/utils/getSeries";
import { postFilter } from "@sage/utils/postFilter";
import { useTranslations } from "@sage/i18n";
import config from "@sage/config";

const posts = (await getCollection("posts")).filter(postFilter);
const series = getAllSeries(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.seriesTitle} | ${config.site.title}`}>
  <Header />
  <Main pageTitle={t.pages.seriesTitle} pageDesc={t.pages.seriesDesc}>
    <ul class="divide-border divide-y">
      {series.map(s => (
        <li class="py-5">
          <a
            href={getRelativeLocaleUrl(locale, `series/${s.slug}/`)}
            class="group block"
          >
            <h2 class="group-hover:text-accent text-xl font-semibold transition-colors">
              {s.name}
            </h2>
            <p class="text-muted-foreground mt-1">
              {s.posts.length} {s.posts.length === 1 ? "part" : "parts"} ·
              started {s.posts[0].data.pubDatetime.getFullYear()}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </Main>
  <Footer />
</Layout>
