---
import { getEntry, render } from "astro:content";
import Layout from "@sage/layouts/Layout.astro";
import Header from "@sage/components/Header.astro";
import Main from "@sage/components/Main.astro";
import Footer from "@sage/components/Footer.astro";
import config from "@sage/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Main pageTitle={about.data.title}>
    <!-- The prose flow rules style direct children, so wrap the content itself. -->
    <div class="app-prose mt-6">
      <Content />
    </div>
  </Main>

  <Footer />
</Layout>
