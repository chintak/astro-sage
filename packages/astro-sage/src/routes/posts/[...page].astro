---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@sage/layouts/Layout.astro";
import Header from "@sage/components/Header.astro";
import Main from "@sage/components/Main.astro";
import Card from "@sage/components/Card.astro";
import Footer from "@sage/components/Footer.astro";
import Pagination from "@sage/components/Pagination.astro";
import { getSortedPosts } from "@sage/utils/getSortedPosts";
import { useTranslations } from "@sage/i18n";
import config from "@sage/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.postsTitle} pageDesc={t.pages.postsDesc}>
    <ul>
      {page.data.map(data => (
        <Card {...data} />
      ))}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
