---
import IconLink from "@sage/assets/icons/IconLink.svg";
import IconShare from "@sage/assets/icons/IconShare.svg";
import config from "@sage/config";

type Props = {
  /** Post title, used by platforms that take one (X, Bluesky, Reddit, HN, email). */
  title: string;
};

const { title } = Astro.props;
const { shareLinks } = config;

// Share the canonical URL (the site URL), never the dev/build host.
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("../../../../assets/icons/socials/*.svg");

const LABELS: Record<string, string> = {
  x: "X",
  linkedin: "LinkedIn",
  bluesky: "Bluesky",
  reddit: "Reddit",
  hackernews: "Hacker News",
  mail: "email",
};

function shareHref(template: string) {
  const url = encodeURIComponent(pageUrl);
  if (!/\{url\}|\{title\}/.test(template)) return template + url;
  return template
    .replaceAll("{url}", url)
    .replaceAll("{title}", encodeURIComponent(title));
}

const items = await Promise.all(
  shareLinks.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`../../../../assets/icons/socials/${name}.svg`]?.();
    const platform =
      LABELS[name] ?? name.charAt(0).toUpperCase() + name.slice(1);
    return {
      href: shareHref(url),
      label:
        linkTitle ??
        (name === "mail" ? "Share via email" : `Share on ${platform}`),
      Icon: mod?.default,
      external: !url.startsWith("mailto:"),
    };
  })
);
---

<div class="share" data-share-url={pageUrl} data-share-title={title}>
  <span class="share-label small-caps">Share</span>
  <ul class="share-list">
    {items.map(({ href, label, Icon, external }) =>
      Icon ? (
        <li>
          <a
            class="share-btn"
            href={href}
            title={label}
            aria-label={label}
            {...(external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            <Icon class="size-[1.15rem]" aria-hidden="true" />
          </a>
        </li>
      ) : null
    )}
    <li>
      <button
        type="button"
        class="share-btn"
        data-copy
        title="Copy link"
        aria-label="Copy link"
      >
        <IconLink class="size-[1.15rem]" aria-hidden="true" />
      </button>
    </li>
    <li hidden data-native-share>
      <button
        type="button"
        class="share-btn"
        title="More options"
        aria-label="Share via…"
      >
        <IconShare class="size-[1.15rem]" aria-hidden="true" />
      </button>
    </li>
  </ul>
  <span class="share-status" role="status" aria-live="polite"></span>
</div>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-family: var(--font-ui);
  }
  .share-label {
    font-size: var(--ui-size);
    color: var(--fg-muted);
  }
  .share-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .share-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-muted);
    transition:
      color 120ms,
      border-color 120ms,
      background-color 120ms;
  }
  .share-btn:hover,
  .share-btn:focus-visible {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 50%, var(--border));
    background: var(--bg-raised);
  }
  .share-status {
    font-size: var(--ui-size);
    color: var(--sage);
  }
</style>

<script>
  for (const el of document.querySelectorAll<HTMLElement>(".share")) {
    const url = el.dataset.shareUrl!;
    const title = el.dataset.shareTitle!;
    const status = el.querySelector<HTMLElement>(".share-status")!;
    el.querySelector("[data-copy]")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = "Link copied";
      } catch {
        status.textContent = url;
      }
      setTimeout(() => (status.textContent = ""), 2000);
    });
    const native = el.querySelector<HTMLElement>("[data-native-share]")!;
    if (typeof navigator.share === "function") {
      native.hidden = false;
      native.querySelector("button")!.addEventListener("click", () => {
        navigator.share({ title, url }).catch(() => {});
      });
    }
  }
</script>
