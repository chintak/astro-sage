---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@sage/assets/icons/IconArrowRight.svg";
import Layout from "@sage/layouts/Layout.astro";
import Header from "@sage/components/Header.astro";
import Footer from "@sage/components/Footer.astro";
import Socials from "@sage/components/Socials.astro";
import Card from "@sage/components/Card.astro";
import { getSortedPosts } from "@sage/utils/getSortedPosts";
import { useTranslations } from "@sage/i18n";
import config from "@sage/config";

const { posts: postsConfig, home, site } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <div class="max-w-measure mx-auto">
      <section class="hero">
        <h1>{home.title ?? site.title}</h1>
        {home.intro && <p class="intro" set:html={home.intro} />}
        <div class="mt-6">
          <Socials
            rss={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          />
        </div>
      </section>

      {featuredPosts.length > 0 && (
        <section aria-labelledby="featured-heading" class="mt-14">
          <h2 id="featured-heading" class="section-label small-caps">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )}

      {recentPosts.length > 0 && (
        <section aria-labelledby="recent-heading" class="mt-14">
          <h2 id="recent-heading" class="section-label small-caps">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )}

      <div class="mt-10">
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="text-accent inline-flex items-center gap-1 hover:underline"
        >
          {t.home.allPosts}
          <IconArrowRight class="size-4 rtl:-rotate-180" />
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }
  .hero h1 {
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.5rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variation-settings: "opsz" 60;
  }
  .intro {
    margin-top: 1.25rem;
    font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.4rem);
    line-height: 1.55;
    color: color-mix(in oklab, var(--fg) 85%, var(--bg));
    text-wrap: pretty;
  }
  .section-label {
    color: var(--fg-muted);
    font-weight: 600;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }
</style>
