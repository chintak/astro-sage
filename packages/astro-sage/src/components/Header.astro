---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import { postFilter } from "@sage/utils/postFilter";
import IconSunHigh from "@sage/assets/icons/IconSunHigh.svg";
import IconSearch from "@sage/assets/icons/IconSearch.svg";
import IconMoon from "@sage/assets/icons/IconMoon.svg";
import IconMenuDeep from "@sage/assets/icons/IconMenuDeep.svg";
import { stripBase, stripLocale } from "@sage/utils/withBase";
import { useTranslations } from "@sage/i18n";
import config from "@sage/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const currentPath = stripLocale(stripBase(Astro.url.pathname), locale);
const isActive = (path: string) =>
  currentPath.split("/").filter(Boolean)[0] ===
  path.split("/").filter(Boolean)[0];

// Only link Series when at least one published post belongs to one.
const hasSeries = (await getCollection("posts")).some(
  post => postFilter(post) && post.data.series
);

const links = [
  { path: "/posts", label: t.nav.posts },
  ...(hasSeries ? [{ path: "/series", label: t.nav.series }] : []),
  { path: "/tags", label: t.nav.tags },
  ...(features.showArchives
    ? [{ path: "/archives", label: t.nav.archives }]
    : []),
  { path: "/about", label: t.nav.about },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-4 -top-full z-50 px-3 py-2 focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="app-layout">
  <div class="border-border flex items-center justify-between gap-6 border-b py-5 sm:py-6">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="site-title text-xl font-semibold whitespace-nowrap sm:text-2xl"
    >
      {site.title}
    </a>

    <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-5 md:flex">
        {links.map(l => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, l.path.slice(1))}
              class:list={["nav-link", { "active-nav": isActive(l.path) }]}
              aria-current={isActive(l.path) ? "page" : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>

      {features.search !== false && (
        <a
          href={getRelativeLocaleUrl(locale, "search")}
          class="icon-btn"
          title={t.nav.search}
          aria-label={t.nav.search}
        >
          <IconSearch class="size-5" />
        </a>
      )}

      {features.lightAndDarkMode && (
        <button
          id="theme-btn"
          class="icon-btn"
          title={t.a11y.toggleTheme}
          aria-label="auto"
          aria-live="polite"
        >
          <IconMoon class="size-5 dark:hidden" />
          <IconSunHigh class="hidden size-5 dark:block" />
        </button>
      )}

      <slot name="actions" />

      <details class="mobile-menu md:hidden">
        <summary class="icon-btn" aria-label={t.a11y.openMenu}>
          <IconMenuDeep class="size-5" />
        </summary>
        <ul>
          {links.map(l => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, l.path.slice(1))}
                class:list={{ "active-nav": isActive(l.path) }}
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>

<style>
  .site-title {
    font-variation-settings: "opsz" 40;
    letter-spacing: -0.01em;
  }
  .nav-link {
    color: var(--fg-muted);
    transition: color 120ms;
  }
  .nav-link:hover {
    color: var(--fg);
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--fg-muted);
    transition:
      color 120ms,
      background-color 120ms;
  }
  .icon-btn:hover {
    color: var(--fg);
    background: var(--bg-raised);
  }
  .mobile-menu {
    position: relative;
  }
  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu ul {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    z-index: 20;
    min-width: 11rem;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg);
    box-shadow: 0 8px 24px -12px rgb(58 49 38 / 0.35);
  }
  .mobile-menu li a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
  }
  .mobile-menu li a:hover {
    background: var(--bg-raised);
  }
</style>
