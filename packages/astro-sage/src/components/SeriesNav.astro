---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@sage/utils/getPostPaths";
import { slugifyStr } from "@sage/utils/slugify";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@sage/config";

type Props = {
  series: string;
  posts: CollectionEntry<"posts">[];
  current: string;
};

const { series, posts, current } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const index = posts.findIndex(p => p.id === current);
---

<nav class="series-nav" aria-label={`Series: ${series}`}>
  <p class="small-caps text-muted-foreground text-sm">
    Part {index + 1} of {posts.length} in{" "}
    <a class="text-sage hover:underline" href={getRelativeLocaleUrl(locale, `series/${slugifyStr(series)}/`)}>{series}</a>
  </p>
  <ol>
    {
      posts.map((p, i) => (
        <li>
          {p.id === current ? (
            <span aria-current="page">{p.data.title}</span>
          ) : (
            <a href={getPostUrl(p.id, p.filePath, locale)}>{p.data.title}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .series-nav {
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--bg-raised);
  }
  ol {
    margin-top: 0.5rem;
    padding-inline-start: 1.4rem;
    list-style: decimal;
    font-variant-numeric: lining-nums;
  }
  li + li {
    margin-top: 0.25rem;
  }
  li::marker {
    color: var(--fg-muted);
  }
  a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.2em;
  }
  a:hover {
    text-decoration-color: var(--accent);
  }
  [aria-current] {
    color: var(--accent);
    font-weight: 600;
  }
</style>
