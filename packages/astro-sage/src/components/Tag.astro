---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@sage/assets/icons/IconHash.svg";
import config from "@sage/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    class:list={[
      "flex items-center gap-0.5 rounded-full px-2.5 py-0.5",
      "bg-surface text-muted-foreground border border-border",
      "hover:text-accent hover:border-accent/50 transition-colors",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
