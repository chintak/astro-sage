---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@sage/assets/icons/IconHash.svg";
import { getTagCounts } from "@sage/utils/getUniqueTags";
import config from "@sage/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /** Override the post count (otherwise looked up from the collection). */
  count?: number;
};

const { tag, tagName, size = "lg" } = Astro.props;
const count = Astro.props.count ?? (await getTagCounts()).get(tag) ?? 0;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    class:list={[
      "tag flex items-center gap-0.5 rounded-full px-2.5 py-0.5",
      "bg-surface text-muted-foreground border-border border",
      "hover:text-accent hover:border-accent/50 transition-colors",
      size,
    ]}
  >
    <IconHash
      class:list={[
        "opacity-70",
        { "size-4": size === "lg", "size-3.5": size === "sm" },
      ]}
    />
    {tagName}
    <span class="tag-count">
      <span aria-hidden="true">{count}</span>
      <span class="sr-only">
        ({count} {count === 1 ? "post" : "posts"})
      </span>
    </span>
  </a>
</li>

<style>
  .tag {
    font-family: var(--font-ui);
    line-height: 1.5;
  }
  .tag.sm {
    font-size: 0.75rem;
  }
  .tag.lg {
    font-size: 0.875rem;
  }
  .tag-count {
    margin-inline-start: 0.45em;
    padding-inline-start: 0.45em;
    border-inline-start: 1px solid var(--border);
    font-variant-numeric: tabular-nums;
    color: var(--fg-muted);
  }
  .tag:hover .tag-count {
    color: inherit;
  }
</style>
