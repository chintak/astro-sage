---
type Props = {
  /** Stable identifier for the post's thread (its slug). */
  slug: string;
};
const { slug } = Astro.props;
---

<section id="comments" class="comments" data-slug={slug} aria-labelledby="comments-heading">
  <h2 id="comments-heading" class="comments-heading">Comments</h2>
  <div class="comments-root" aria-live="polite">
    <p class="comments-muted">Loading comments…</p>
  </div>
  <noscript><p class="comments-muted">Comments need JavaScript.</p></noscript>
</section>

<script>
  // Load the comments client only when the section approaches the viewport,
  // so readers who never scroll this far download nothing.
  const el = document.querySelector<HTMLElement>("#comments");
  if (el) {
    const io = new IntersectionObserver(
      entries => {
        if (!entries.some(e => e.isIntersecting)) return;
        io.disconnect();
        import("@sage/comments/client").then(m => m.mount(el));
      },
      { rootMargin: "600px 0px" }
    );
    io.observe(el);
  }
</script>

<style is:global>
  .comments {
    scroll-margin-top: 2rem;
  }
  .comments-heading {
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .comments-muted {
    color: var(--fg-muted);
    font-style: italic;
  }
  .comments-signin {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--border);
    border-radius: 0.5rem;
    color: var(--fg-muted);
  }
  .c-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: var(--fg);
    font-size: 0.9rem;
    transition: border-color 120ms, color 120ms;
  }
  .c-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .c-btn[data-primary] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .c-btn[data-primary]:hover {
    filter: brightness(1.05);
    color: var(--accent-fg);
  }
  .c-btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .c-link {
    color: var(--fg-muted);
    font-size: 0.85rem;
  }
  .c-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .c-form {
    display: grid;
    gap: 0.6rem;
  }
  .c-form textarea {
    width: 100%;
    min-height: 6rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--bg-raised) 50%, var(--bg));
    color: var(--fg);
    font: inherit;
    font-size: 1rem;
    line-height: 1.55;
    resize: vertical;
  }
  .c-form textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .c-form-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .c-viewer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .c-list {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.5rem;
  }
  .c-item {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
  }
  .c-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    object-fit: cover;
  }
  .c-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.9rem;
  }
  .c-name {
    font-weight: 600;
  }
  .c-meta {
    color: var(--fg-muted);
    font-size: 0.8rem;
  }
  .c-body {
    margin-top: 0.25rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .c-body p + p {
    margin-top: 0.6em;
  }
  .c-body a {
    color: var(--accent);
    text-decoration: underline;
  }
  .c-body code {
    font-size: 0.85em;
    padding: 0.1em 0.3em;
    border-radius: 0.25em;
    background: var(--bg-raised);
  }
  .c-body pre {
    margin-top: 0.6em;
    padding: 0.75rem;
    overflow-x: auto;
    border-radius: 0.375rem;
    background: var(--bg-raised);
  }
  .c-body pre code {
    padding: 0;
    background: none;
  }
  .c-actions {
    margin-top: 0.35rem;
    display: flex;
    gap: 0.9rem;
  }
  .c-replies {
    margin-top: 1rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--border);
    display: grid;
    gap: 1.25rem;
  }
  .c-error {
    color: var(--callout-caution);
    font-size: 0.9rem;
  }
</style>
